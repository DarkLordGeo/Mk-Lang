// CeNow is 2026-05-29T00:53:20Z in Unix nanoseconds.
const CeNow: i64 = 1_780_000_000_000_000_000

// CeOne writes der as one record (a 4-byte little-endian length, then the
// bytes) at b[at..] and returns the end.
CeOne(b: mut []u8, at: int, der: []u8): int {
    k := der.Len()
    b[at] = Trunc[u8](k)
    b[at + 1] = Trunc[u8](k >> 8)
    b[at + 2] = Trunc[u8](k >> 16)
    b[at + 3] = Trunc[u8](k >> 24)
    for i, x in der {
        b[at + 4 + i] = x
    }
    return at + 4 + k
}

test "RT8-Cert-Verify the platform refuses an untrusted self-signed chain, bad bytes and malformed records; Linux has no platform verifier" (sys: &System) {
    io := sys.io
    var b: [1024]u8 = [0; 1024]
    der := CeDer
    n := CeOne(mut b[..], 0, der[..])
    r := rt.CertVerify(io, b[0..n], "mk.test", CeNow)
    if !PWin() {
        Assert(r.err == core.SysErr.Unsupported)
        return
    }
    // CERT_E_UNTRUSTEDROOT: built, but its root is in no store.
    Assert(r.err == core.SysErr.None && r.value == 0x800B_0109)
    // With no host, and after its validity: still refused.
    r2 := rt.CertVerify(io, b[0..n], "", CeNow)
    Assert(r2.err == core.SysErr.None && r2.value == 0x800B_0109)
    r3 := rt.CertVerify(io, b[0..n], "mk.test", 7_258_118_400_000_000_000)
    Assert(r3.err == core.SysErr.None && r3.value != 0)
    // The same certificate twice: the second goes to the store; refused.
    m := CeOne(mut b[..], n, der[..])
    Assert(rt.CertVerify(io, b[0..m], "mk.test", CeNow).value != 0)
    // Bytes crypt32 cannot parse.
    var bad: [3]u8 = [0x30, 0x01, 0xFF]
    k := CeOne(mut b[..], 0, bad[..])
    Assert(rt.CertVerify(io, b[0..k], "mk.test", CeNow).err == core.SysErr.Other)
    // Malformed records: none, a length past the end, an empty one, 17.
    Assert(rt.CertVerify(io, b[0..0], "mk.test", CeNow).err == core.SysErr.Other)
    Assert(rt.CertVerify(io, b[0..k - 1], "mk.test", CeNow).err == core.SysErr.Other)
    var empty: [4]u8 = [0; 4]
    Assert(rt.CertVerify(io, empty[..], "mk.test", CeNow).err == core.SysErr.Other)
    var many: [128]u8 = [0; 128]
    var at := 0
    for _ in 0..17 {
        at = CeOne(mut many[..], at, bad[..])
    }
    Assert(rt.CertVerify(io, many[0..at], "mk.test", CeNow).err == core.SysErr.Other)
    // A cancelled scope's call is Canceled before it starts.
    n2 := CeOne(mut b[..], 0, der[..])
    var rc := core.IoResult(value: 0, err: core.SysErr.None, os: 0)
    scope s := io.Scope() {
        s.Cancel()
        rc = rt.CertVerify(io, b[0..n2], "mk.test", CeNow)
    }
    Assert(rc.err == core.SysErr.Canceled)
}
// CeRootMax bounds the roots file RT8-Cert-Roots reads.
const CeRootMax: int = 16384

test "RT8-Cert-Roots every root that Go's platform verifier trusts is trusted here (MK_RT8_ROOTS, set by TestRt_CertRoots)" (sys: &System) {
    io := sys.io
    path := sys.Env("MK_RT8_ROOTS") else { "" }
    if path.Len() == 0 || !PWin() {
        return
    }
    o := NativeOpen(io, path, 0)
    Assert(o.err == core.SysErr.None)
    h := Trunc[uint](o.value)
    var buf: [16384]u8 = [0; 16384]
    var n := 0
    for n < CeRootMax {
        r := NativeRead(io, h, mut buf[n..CeRootMax], -1)
        Assert(r.err == core.SysErr.None)
        if r.value == 0 {
            break
        }
        n += Trunc[int](r.value)
    }
    Assert(NativeClose(io, h).err == core.SysErr.None)
    now := rt.WallClock(io).value
    var at := 0
    var count := 0
    for at < n {
        k := int(buf[at]) | (int(buf[at + 1]) << 8) | (int(buf[at + 2]) << 16) | (int(buf[at + 3]) << 24)
        r := rt.CertVerify(io, buf[at..at + 4 + k], "", now)
        Assert(r.err == core.SysErr.None && r.value == 0)
        at += 4 + k
        count += 1
    }
    Assert(count >= 1)
}
