    var n: u64 = 0
    for t in 0..4 {
        j := i + 64 * t
        n = n | (((u64(k[k.Len() - 1 - j / 8]) >> Cast[u64](j % 8)) & 1) << Cast[u64](t))
    }
    return n
}

// P256CombLookup is entry n (0 to 15, secret) of comb table t (0 or 1)
// as a projective point, the identity for 0: every entry is read and one
// kept by mask (equality by arithmetic, not a comparison).
P256CombLookup(t: int, n: u64): P256Pt {
    var x: [4]u64 = [0; 4]
    var y := P256One
    var z: [4]u64 = [0; 4]
    var i: u64 = 1
    for e in 0..15 {
        m := ((i ^ n) -% 1) >> 63
        b := 2 * 4 * (15 * t + e)
        var ex: [4]u64 = [0; 4]
        var ey: [4]u64 = [0; 4]
        for w in 0..4 {
            ex[w] = P256Comb[b + w]
            ey[w] = P256Comb[b + 4 + w]
        }
        x = P256Selectznz(m, &x, &ex)
        y = P256Selectznz(m, &y, &ey)
        z = P256Selectznz(m, &z, &P256One)
        i += 1
    }
    return P256Pt(x: x, y: y, z: z)
}

// P256PtBaseMul is k G for k as 32 big-endian bytes, constant time:
// Lim and Lee's comb over two precomputed tables (P256Comb; the shape
// of BoringSSL's and fiat-crypto's P-256 base multiplication), 31
// doublings and 64 complete additions of masked table entries, the same
// sequence for every k.
P256PtBaseMul(k: []u8): P256Pt {
    var p := P256Identity
    var i := 31
    for i >= 0 {
        if i != 31 {
            p = P256PtDouble(&p)
        }
        p = P256PtAdd(&p, &P256CombLookup(0, P256CombBits(k, i)))
        p = P256PtAdd(&p, &P256CombLookup(1, P256CombBits(k, i + 32)))
        i -= 1
    }
    return p
}
