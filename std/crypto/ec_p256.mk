    x3 = P256Sub(&x3, &v)
    x3 = P256Sub(&x3, &v)
    var y3 := P256Sub(&v, &x3)
    y3 = P256Mul(&r, &y3)
    sj := P256Mul(&s1, &j)
    sj2 := P256Add(&sj, &sj)
    y3 = P256Sub(&y3, &sj2)
    var z3 := P256Add(&p.z, &q.z)
    z3 = P256Square(&z3)
    z3 = P256Sub(&z3, &z1z1)
    z3 = P256Sub(&z3, &z2z2)
    z3 = P256Mul(&z3, &h)
    return P256VtPt(x: x3, y: y3, z: z3)
}

// P256VtNeg is -p.
P256VtNeg(p: &P256VtPt): P256VtPt {
    return P256VtPt(x: p.x, y: P256Opp(&p.y), z: p.z)
}

// P256VtGOdd is (2 j + 1) G from P256GOdd, negated when neg.
P256VtGOdd(j: int, neg: bool): P256VtAffine {
    var x: [4]u64 = [0; 4]
    var y: [4]u64 = [0; 4]
    b := 2 * 4 * j
    for w in 0..4 {
        x[w] = P256GOdd[b + w]
        y[w] = P256GOdd[b + 4 + w]
    }
    if neg {
        y = P256Opp(&y)
    }
    return P256VtAffine(x: x, y: y)
}

// P256VtMulAdd is u1 G + u2 q for public scalars (big-endian, 32
// bytes each) and a public q, as ECDSA verification needs: Straus' shared
// doublings over width-6 and width-5 NAFs (Möller 2001's interleaving, as
// BoringSSL and Go's generic path verify), G's odd multiples affine from
// P256GOdd and added by P256VtAddAffine, q's 8 made per call in Jacobian
// coordinates and added by P256VtAdd, the leading doublings of the
// point at infinity skipped. Variable time; public data only.
P256VtMulAdd(u1: []u8, q: &P256VtAffine, u2: []u8): P256VtPt {
    var n1: [257]int = [0; 257]
    var n2: [257]int = [0; 257]
    P256Naf(u1, 6, mut n1)
    P256Naf(u2, 5, mut n2)
    var tq: [8]P256VtPt = [P256VtInf; 8]
    tq[0] = P256VtPt(x: q.x, y: q.y, z: P256One)
    q2 := P256VtDouble(&tq[0])
    for i in 1..8 {
        tq[i] = P256VtAdd(&tq[i - 1], &q2)
    }
    var p := P256VtInf
    var started := false
    var i := 257 - 1
    for i >= 0 {
        if started {
            p = P256VtDouble(&p)
        }
        a := n1[i]
        if a != 0 {
            ma := if a > 0 { a } else { -a }
            g := P256VtGOdd(ma / 2, a < 0)
            p = P256VtAddAffine(&p, &g)
            started = true
        }
        b := n2[i]
        if b != 0 {
            if b > 0 {
                p = P256VtAdd(&p, &tq[b / 2])
            } else {
                t := P256VtNeg(&tq[-b / 2])
                p = P256VtAdd(&p, &t)
            }
            started = true
        }
        i -= 1
    }
    return p
}

// P256VtXIs reports whether p is not the point at infinity and its
// affine x, reduced mod n, is r (32 big-endian bytes, below n), with no
// inversion: x = X / Z^2, so x = r exactly when X = r Z^2. x is below p and
// n < p < 2 n, so x mod n = r also when x = r + n, which is below p only
// for r below p - n (P256PMinusN); r + n is not formed otherwise, so the
// sum cannot wrap.
P256VtXIs(p: &P256VtPt, r: []u8): bool {
    if P256VtIsInf(p) {
        return false
    }
    z2 := P256Square(&p.z)
    a := P256Limbs(r)
    ra := P256ToMontgomery(&a)
    t := P256Mul(&ra, &z2)
    if P256Equal(&t, &p.x) {
        return true
    }
    if P256Below(&a, &P256PMinusN) == 0 {
        return false
    }
    var b: [4]u64 = [0; 4]
    var c: u64 = 0
    for i in 0..4 {
        w := FiatAdd64(a[i], P256nN[i], c)
        b[i] = w.s
        c = w.c
    }
    rb := P256ToMontgomery(&b)
    t2 := P256Mul(&rb, &z2)
    return P256Equal(&t2, &p.x)
}

// P256PtFromBytes is the point SEC 1 2.3.4 encodes in b uncompressed
// (0x04, x, y; 65 bytes), or none when b is any other length or form
// (the identity's and compressed encodings included), a coordinate is not
// below p, or the point is not on the curve, y^2 = x^3 - 3x + b. Public
// data.
P256PtFromBytes(b: []u8): ?P256Pt {
    if b.Len() != 65 || b[0] != 4 {
        return none
    }
    x := P256Decode(b[1..33]) else {
        return none
    }
    y := P256Decode(b[33..65]) else {
        return none
    }
    cb := P256B
    var rhs := P256Square(&x)
    rhs = P256Mul(&rhs, &x)
    var x3 := P256Add(&x, &x)
    x3 = P256Add(&x3, &x)
    rhs = P256Sub(&rhs, &x3)
    rhs = P256Add(&rhs, &cb)
    lhs := P256Square(&y)
    if !P256Equal(&lhs, &rhs) {
        return none
    }
    return some(P256Pt(x: x, y: y, z: P256One))
}

// P256PtBytes writes p's uncompressed SEC 1 encoding (65 bytes) at the
// front of out and reports true, or writes nothing and reports false for
// the identity. Constant time but for that answer.
P256PtBytes(p: &P256Pt, out: mut []u8): bool {
    if P256IsZero(&p.z) == 1 {
        return false
    }
    zi := P256Invert(&p.z)
    x := P256Mul(&p.x, &zi)
    y := P256Mul(&p.y, &zi)
    out[0] = 4
    P256Encode(&x, mut out[1..33])
    P256Encode(&y, mut out[33..65])
    return true
}

// P256PtXBytes writes p's affine x (32 big-endian bytes) at the front
// of out and reports true, or writes nothing and reports false for the
// identity. Constant time but for that answer.
P256PtXBytes(p: &P256Pt, out: mut []u8): bool {
    if P256IsZero(&p.z) == 1 {
        return false
    }
    zi := P256Invert(&p.z)
    x := P256Mul(&p.x, &zi)
    P256Encode(&x, mut out[0..32])
    return true
}

// P256nDigest is the digest as a scalar, FIPS 186-5 6.4.1's bits2int
// reduced by the order: its leftmost 32 bytes (all of it, left-padded
// with zeros, when shorter), mod n. Constant time.
P256nDigest(digest: []u8): [4]u64 {
    var e: [32]u8 = [0; 32]
    if digest.Len() >= 32 {
        (mut e[..]).CopyFrom(digest[0..32])
    } else {
        (mut e[32 - digest.Len()..32]).CopyFrom(digest)
    }
    return P256nReduce(e[..])
}

// P256EcdsaVerify reports whether r and s (32 big-endian bytes each)
// are an ECDSA signature of digest under the public point q (SEC 1
// uncompressed), FIPS 186-5 6.4.2: false for an empty digest, a q not on
// the curve, r or s not in [1, n - 1], or R = u1 G + u2 Q the identity.
// Public data, variable time: the P256Vt functions' Jacobian formulas
// and one inversion (of s, in the scalar field).
P256EcdsaVerify(q: []u8, digest: []u8, r: []u8, s: []u8): bool {
    if digest.Len() == 0 {
        return false
    }
    qp := P256PtFromBytes(q) else {
        return false
    }
    rs := P256nDecode(r) else {
        return false
    }
    ss := P256nDecode(s) else {
        return false
    }
    if P256nIsZero(&rs) == 1 || P256nIsZero(&ss) == 1 {
        return false
    }
    e := P256nDigest(digest)
    w := P256nInvert(&ss)
    u1 := P256nMul(&e, &w)
    u2 := P256nMul(&rs, &w)
    var b1: [32]u8 = [0; 32]
    var b2: [32]u8 = [0; 32]
    P256nEncode(&u1, mut b1[..])
    P256nEncode(&u2, mut b2[..])
    qa := P256VtAffine(x: qp.x, y: qp.y)
    rp := P256VtMulAdd(b1[..], &qa, b2[..])
    return P256VtXIs(&rp, r)
}

