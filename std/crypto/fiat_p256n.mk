//
// Input Bounds:
//   arg1: [[0x0 ~> 0xffffffffffffffff], [0x0 ~> 0xffffffffffffffff], [0x0 ~> 0xffffffffffffffff], [0x0 ~> 0xffffffffffffffff]]
// Output Bounds:
//   out1: [0x0 ~> 0xffffffffffffffff]
P256nNonzero(arg1: &[4]u64): u64 {
    var out1: u64 = 0
    x1 := (arg1[0] | (arg1[1] | (arg1[2] | arg1[3])))
    out1 = x1
    return out1
}

