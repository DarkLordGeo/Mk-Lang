    t0 := P384Sub(&p.x, &delta)
    t1 := P384Add(&p.x, &delta)
    a1 := P384Mul(&t0, &t1)
    a2 := P384Add(&a1, &a1)
    alpha := P384Add(&a2, &a1)
    b2 := P384Add(&beta, &beta)
    b4 := P384Add(&b2, &b2)
    b8 := P384Add(&b4, &b4)
