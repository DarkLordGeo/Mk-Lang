    z1z1 := P384Square(&p.z)
    z2z2 := P384Square(&q.z)
    u1 := P384Mul(&p.x, &z2z2)
    u2 := P384Mul(&q.x, &z1z1)
    var s1 := P384Mul(&p.y, &q.z)
    s1 = P384Mul(&s1, &z2z2)
    var s2 := P384Mul(&q.y, &p.z)
    s2 = P384Mul(&s2, &z1z1)
    h := P384Sub(&u2, &u1)
    d := P384Sub(&s2, &s1)
    if P384IsZero(&h) == 1 {
        if P384IsZero(&d) == 1 {
            return P384VtDouble(p)
        }
        return P384VtInf
    }
    h2 := P384Add(&h, &h)
    i := P384Square(&h2)
    j := P384Mul(&h, &i)
    r := P384Add(&d, &d)
    v := P384Mul(&u1, &i)
    var x3 := P384Square(&r)
    x3 = P384Sub(&x3, &j)
    x3 = P384Sub(&x3, &v)
    x3 = P384Sub(&x3, &v)
    var y3 := P384Sub(&v, &x3)
    y3 = P384Mul(&r, &y3)
    sj := P384Mul(&s1, &j)
    sj2 := P384Add(&sj, &sj)
    y3 = P384Sub(&y3, &sj2)
    var z3 := P384Add(&p.z, &q.z)
    z3 = P384Square(&z3)
    z3 = P384Sub(&z3, &z1z1)
    z3 = P384Sub(&z3, &z2z2)
    z3 = P384Mul(&z3, &h)
    return P384VtPt(x: x3, y: y3, z: z3)
}

// P384VtNeg is -p.
P384VtNeg(p: &P384VtPt): P384VtPt {
    return P384VtPt(x: p.x, y: P384Opp(&p.y), z: p.z)
}

// P384VtGOdd is (2 j + 1) G from P384GOdd, negated when neg.
P384VtGOdd(j: int, neg: bool): P384VtAffine {
    var x: [6]u64 = [0; 6]
    var y: [6]u64 = [0; 6]
    b := 2 * 6 * j
    for w in 0..6 {
        x[w] = P384GOdd[b + w]
        y[w] = P384GOdd[b + 6 + w]
    }
    if neg {
        y = P384Opp(&y)
    }
    return P384VtAffine(x: x, y: y)
}

// P384VtMulAdd is u1 G + u2 q for public scalars (big-endian, 48
// bytes each) and a public q, as ECDSA verification needs: Straus' shared
// doublings over width-6 and width-5 NAFs (Möller 2001's interleaving, as
// BoringSSL and Go's generic path verify), G's odd multiples affine from
// P384GOdd and added by P384VtAddAffine, q's 8 made per call in Jacobian
// coordinates and added by P384VtAdd, the leading doublings of the
// point at infinity skipped. Variable time; public data only.
P384VtMulAdd(u1: []u8, q: &P384VtAffine, u2: []u8): P384VtPt {
    var n1: [385]int = [0; 385]
    var n2: [385]int = [0; 385]
    P384Naf(u1, 6, mut n1)
    P384Naf(u2, 5, mut n2)
    var tq: [8]P384VtPt = [P384VtInf; 8]
    tq[0] = P384VtPt(x: q.x, y: q.y, z: P384One)
    q2 := P384VtDouble(&tq[0])
    for i in 1..8 {
        tq[i] = P384VtAdd(&tq[i - 1], &q2)
    }
    var p := P384VtInf
    var started := false
    var i := 385 - 1
    for i >= 0 {
        if started {
            p = P384VtDouble(&p)
        }
        a := n1[i]
        if a != 0 {
            ma := if a > 0 { a } else { -a }
            g := P384VtGOdd(ma / 2, a < 0)
            p = P384VtAddAffine(&p, &g)
            started = true
        }
        b := n2[i]
        if b != 0 {
            if b > 0 {
                p = P384VtAdd(&p, &tq[b / 2])
            } else {
                t := P384VtNeg(&tq[-b / 2])
                p = P384VtAdd(&p, &t)
            }
            started = true
        }
        i -= 1
    }
    return p
}

// P384VtXIs reports whether p is not the point at infinity and its
// affine x, reduced mod n, is r (48 big-endian bytes, below n), with no
// inversion: x = X / Z^2, so x = r exactly when X = r Z^2. x is below p and
// n < p < 2 n, so x mod n = r also when x = r + n, which is below p only
// for r below p - n (P384PMinusN); r + n is not formed otherwise, so the
// sum cannot wrap.
P384VtXIs(p: &P384VtPt, r: []u8): bool {
    if P384VtIsInf(p) {
        return false
    }
    z2 := P384Square(&p.z)
    a := P384Limbs(r)
    ra := P384ToMontgomery(&a)
    t := P384Mul(&ra, &z2)
    if P384Equal(&t, &p.x) {
        return true
    }
    if P384Below(&a, &P384PMinusN) == 0 {
        return false
    }
    var b: [6]u64 = [0; 6]
    var c: u64 = 0
    for i in 0..6 {
        w := FiatAdd64(a[i], P384nN[i], c)
        b[i] = w.s
        c = w.c
    }
    rb := P384ToMontgomery(&b)
    t2 := P384Mul(&rb, &z2)
    return P384Equal(&t2, &p.x)
}

// P384PtFromBytes is the point SEC 1 2.3.4 encodes in b uncompressed
// (0x04, x, y; 97 bytes), or none when b is any other length or form
// (the identity's and compressed encodings included), a coordinate is not
// below p, or the point is not on the curve, y^2 = x^3 - 3x + b. Public
// data.
P384PtFromBytes(b: []u8): ?P384Pt {
    if b.Len() != 97 || b[0] != 4 {
        return none
    }
    x := P384Decode(b[1..49]) else {
        return none
    }
    y := P384Decode(b[49..97]) else {
        return none
    }
    cb := P384B
    var rhs := P384Square(&x)
    rhs = P384Mul(&rhs, &x)
    var x3 := P384Add(&x, &x)
    x3 = P384Add(&x3, &x)
    rhs = P384Sub(&rhs, &x3)
    rhs = P384Add(&rhs, &cb)
    lhs := P384Square(&y)
    if !P384Equal(&lhs, &rhs) {
        return none
    }
    return some(P384Pt(x: x, y: y, z: P384One))
}

// P384PtBytes writes p's uncompressed SEC 1 encoding (97 bytes) at the
// front of out and reports true, or writes nothing and reports false for
// the identity. Constant time but for that answer.
P384PtBytes(p: &P384Pt, out: mut []u8): bool {
    if P384IsZero(&p.z) == 1 {
        return false
    }
    zi := P384Invert(&p.z)
    x := P384Mul(&p.x, &zi)
    y := P384Mul(&p.y, &zi)
    out[0] = 4
    P384Encode(&x, mut out[1..49])
    P384Encode(&y, mut out[49..97])
    return true
}

// P384PtXBytes writes p's affine x (48 big-endian bytes) at the front
// of out and reports true, or writes nothing and reports false for the
// identity. Constant time but for that answer.
P384PtXBytes(p: &P384Pt, out: mut []u8): bool {
    if P384IsZero(&p.z) == 1 {
        return false
    }
    zi := P384Invert(&p.z)
    x := P384Mul(&p.x, &zi)
    P384Encode(&x, mut out[0..48])
    return true
}

// P384nDigest is the digest as a scalar, FIPS 186-5 6.4.1's bits2int
// reduced by the order: its leftmost 48 bytes (all of it, left-padded
// with zeros, when shorter), mod n. Constant time.
P384nDigest(digest: []u8): [6]u64 {
    var e: [48]u8 = [0; 48]
    if digest.Len() >= 48 {
        (mut e[..]).CopyFrom(digest[0..48])
    } else {
        (mut e[48 - digest.Len()..48]).CopyFrom(digest)
    }
    return P384nReduce(e[..])
}

// P384EcdsaVerify reports whether r and s (48 big-endian bytes each)
// are an ECDSA signature of digest under the public point q (SEC 1
// uncompressed), FIPS 186-5 6.4.2: false for an empty digest, a q not on
// the curve, r or s not in [1, n - 1], or R = u1 G + u2 Q the identity.
// Public data, variable time: the P384Vt functions' Jacobian formulas
// and one inversion (of s, in the scalar field).
P384EcdsaVerify(q: []u8, digest: []u8, r: []u8, s: []u8): bool {
    if digest.Len() == 0 {
        return false
    }
    qp := P384PtFromBytes(q) else {
        return false
    }
    rs := P384nDecode(r) else {
        return false
    }
    ss := P384nDecode(s) else {
        return false
    }
    if P384nIsZero(&rs) == 1 || P384nIsZero(&ss) == 1 {
        return false
    }
    e := P384nDigest(digest)
    w := P384nInvert(&ss)
    u1 := P384nMul(&e, &w)
    u2 := P384nMul(&rs, &w)
    var b1: [48]u8 = [0; 48]
    var b2: [48]u8 = [0; 48]
    P384nEncode(&u1, mut b1[..])
    P384nEncode(&u2, mut b2[..])
    qa := P384VtAffine(x: qp.x, y: qp.y)
    rp := P384VtMulAdd(b1[..], &qa, b2[..])
    return P384VtXIs(&rp, r)
}

