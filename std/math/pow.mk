// PowLog is ln x as hi + lo, |lo| <= ulp(hi) / 2, for x's bits ix: x is
// positive and finite, and ix of a subnormal x is normalized with its
// exponent carried below the field's range (Pow's caller). The relative
// error is about 2^-68: every step is exact but the sum of the small terms
// in lo and the series.
PowLog(ix: u64): (hi: f64, lo: f64) {
    tmp := ix -% LogOff
    i := Trunc[int]((tmp >> 45) & 127) * 3
    k := Trunc[i64](tmp) >> 52
    iz := ix -% (tmp & 0xFFF0000000000000)
    z := f64.FromBits(iz)
    invc := f64.FromBits(PowLogT[i])
    // z = zhi + zlo with zhi of 21 bits: both products are exact, and so is
    // their sum, r = z invc - 1 (TestSTDMATH_Tables).
    zhi := f64.FromBits((iz +% 0x80000000) & 0xFFFFFFFF00000000)
    r := (zhi * invc - 1.0) + (z - zhi) * invc
    kd := Cast[f64](k)
    // k ln2 + ln c is exact; t2 + lo2 = t1 + r exactly (|t1| >= |r| or t1 = 0).
    t1 := kd * LogLn2Hi + f64.FromBits(PowLogT[i + 1])
    t2 := t1 + r
    lo1 := kd * LogLn2Lo + f64.FromBits(PowLogT[i + 2])
    lo2 := (t1 - t2) + r
    // -r^2/2 = -rh^2/2, exact for rh of 26 bits, less rl (r + rh) / 2.
    rh := f64.FromBits(r.Bits() & 0xFFFFFFFFF8000000)
    rl := r - rh
    arh2 := rh * (-0.5 * rh)
    hi := t2 + arh2
    lo3 := rl * (-0.5 * (r + rh))
    lo4 := (t2 - hi) + arh2
    r2 := r * r
    p := r2 * r * (PowA3 + r * PowA4 + r2 * (PowA5 + r * PowA6) + r2 * r2 * (PowA7 + r * PowA8 + r2 * (PowA9 + r * PowA10)))
    lo := lo1 + lo2 + lo3 + lo4 + p
    y := hi + lo
    return (hi: y, lo: (hi - y) + lo)
}

// Parity says whether y is an odd integer (1), an even one (2), or not an
// integer (0).
Parity(y: f64): int {
    a := y.Bits() & AbsMask64
    if a >= 0x4340000000000000 {
        return 2 // |y| >= 2^53: every such f64 is an even integer
    }
    if a < 0x3FF0000000000000 || Floor(y) != y {
        return 0
    }
    return if Cast[i64](y) & 1 == 1 { 1 } else { 2 }
}

// Signed is s * r for s = +-1, without the multiply that could change a
// NaN or round.
Signed(neg: bool, r: f64): f64 {
    return if neg { -r } else { r }
}

/// Pow is x to the power y, with C99's special cases: Pow(x, 0) and Pow(1, y)
/// are 1 for every x and y, a NaN included; a negative x to a power that is not
/// an integer is Nan; a zero to a negative power is an infinity; an overflow is
/// an infinity and an underflow a zero, of the result's sign. Faithfully
/// rounded (within 1 ulp) but not correctly rounded, so its results may change
/// in a minor release. TestSTDMATH_TrueError: largest error 0.503 ulp over
/// 21,681 inputs, 11 of them not correctly rounded. Over the 3,069 adversarial
/// and random inputs of TestSTDMATH_Edges, largest error 0.504 ulp. O(1);
/// allocates nothing.
export Pow(x: f64, y: f64): f64 {
    bx := x.Bits()
    by := y.Bits()
    ax := bx & AbsMask64
    ay := by & AbsMask64
    xneg := bx & SignBit64 != 0
    yneg := by & SignBit64 != 0
    if ay == 0 || bx == 0x3FF0000000000000 {
        return 1.0
    }
    if ax > ExpMask64 || ay > ExpMask64 {
        return Nan
    }
    yisint := if xneg { Parity(y) } else { 0 }
    // Special values of y.
    if ay == ExpMask64 {
        if ax == 0x3FF0000000000000 {
            return 1.0 // (-1)^+-inf
        }
        if ax > 0x3FF0000000000000 {
            return if yneg { 0.0 } else { Inf } // |x| > 1
        }
        return if yneg { Inf } else { 0.0 } // |x| < 1
    }
    if ay == 0x3FF0000000000000 {
        return if yneg { 1.0 / x } else { x }
    }
    if by == 0x4000000000000000 {
        return x * x
    }
    if by == 0x3FE0000000000000 && !xneg {
        return Sqrt(x)
    }
    // Special values of x: +-0, +-inf, +-1.
    if ax == 0 || ax == ExpMask64 || ax == 0x3FF0000000000000 {
        var z := f64.FromBits(ax)
        if yneg {
            z = 1.0 / z
        }
        if xneg {
            if ax == 0x3FF0000000000000 && yisint == 0 {
                return Nan // (-1)^non-integer
            }
            if yisint == 1 {
                z = -z
            }
        }
        return z
    }
    if xneg && yisint == 0 {
        return Nan // a negative x to a power that is not an integer
    }
    neg := xneg && yisint == 1
    // |y| >= 2^63, where |y ln x| >= 2^10 since x != 1, or |y| < 2^-65,
    // where x^y rounds to 1. y is then not an odd integer, so neg is false.
    ty := ay >> 52
    if ty -% 0x3BE >= 0x43E - 0x3BE {
        if ty < 0x3BE {
            return if ax > 0x3FF0000000000000 { 1.0 + y } else { 1.0 - y }
        }
        return if (ax > 0x3FF0000000000000) == !yneg { Inf } else { 0.0 }
    }
    var ix := ax
    if ix < 0x0010000000000000 {
        ix = (f64.FromBits(ix) * Two54).Bits() -% 0x0360000000000000 // subnormal: less 54 << 52
    }
    l := PowLog(ix)
    // y (hi + lo) as ehi + elo: y and hi cut to 26 bits, so ehi is exact.
    yh := f64.FromBits(by & 0xFFFFFFFFF8000000)
    lh := f64.FromBits(l.hi.Bits() & 0xFFFFFFFFF8000000)
    ehi := yh * lh
    elo := (y - yh) * lh + y * ((l.hi - lh) + l.lo)
    ea := ehi.Bits() & AbsMask64
    if ea < 0x3C90000000000000 {
        return Signed(neg, 1.0 + ehi) // |y ln x| < 2^-54
    }
    if ea >= 0x4090000000000000 {
        // |y ln x| >= 1024
        return Signed(neg, if ehi < 0.0 { 0.0 } else { Inf })
    }
    return Signed(neg, ExpCore(ehi, elo))
}
