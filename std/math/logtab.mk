// End of the generated block (log).

// The bits of 1 - 2^-4 and of 1 + 0x1.09p-4, the ends of LogNear1's range.
const LogNearLo: u64 = 0x3FEE000000000000
const LogNearHi: u64 = 0x3FF1090000000000

// LogOff is the bits of 0.6875, where row 0 of LogT and PowLogT starts.
const LogOff: u64 = 0x3FE6000000000000

/// Log is the natural logarithm: -inf at a zero, Nan below zero or for a NaN,
/// inf for inf. Correctly rounded on every input tested, but not proved so for
/// every input, so its results may change in a minor release.
/// TestSTDMATH_TrueError: largest error 0.500 ulp over 20,181 inputs, every
/// one correctly rounded. Over the 3,412 adversarial and random inputs of
/// TestSTDMATH_Edges, largest error 0.500 ulp. O(1); allocates nothing.
export Log(x: f64): f64 {
    var ix := x.Bits()
    if ix -% LogNearLo <= LogNearHi - LogNearLo {
        return LogNear1(x)
    }
    if ix -% 0x0010000000000000 >= 0x7FE0000000000000 {
        // x is a zero, subnormal, negative, an infinity or a NaN
        if ix & AbsMask64 == 0 {
            return -Inf
        }
        if ix == ExpMask64 {
            return x
        }
        if ix & SignBit64 != 0 || ix > ExpMask64 {
            return Nan
        }
        ix = (x * Two54).Bits() -% 0x0360000000000000 // subnormal: less 54 << 52
    }
    tmp := ix -% LogOff
    i := Trunc[int]((tmp >> 45) & 127) * 5
    k := Trunc[i64](tmp) >> 52
    z := f64.FromBits(ix -% (tmp & 0xFFF0000000000000))
    invc := f64.FromBits(LogT[i])
    r := ((z - f64.FromBits(LogT[i + 1])) - f64.FromBits(LogT[i + 2])) * invc
    kd := Cast[f64](k)
    w := kd * LogLn2Hi + f64.FromBits(LogT[i + 3])
    hi := w + r
    lo := ((w - hi) + r) + (kd * LogLn2Lo + f64.FromBits(LogT[i + 4]))
    r2 := r * r
    return lo + r2 * LogA2 + r * r2 * (LogA3 + r * LogA4 + r2 * (LogA5 + r * LogA6 + r2 * LogA7)) + hi
}
