// ExpShift is 1.5 * 2^52: z + ExpShift rounds z to an integer held in the
// low bits of the sum's encoding.
const ExpShift: f64 = f64.FromBits(0x4338000000000000)

// 2^1009 and 2^-1022, the scales of ExpScaled.
const ExpUp: f64 = f64.FromBits(0x7F00000000000000)
const ExpDown: f64 = f64.FromBits(0x0010000000000000)

// ExpScaled is scale (1 + tmp) for the scale whose bits are sbits, where
// adding m to the exponent field may have overflowed it (up) or the result
// is subnormal (not up): the scale is moved by 2^1009 or 2^-1022 and moved
// back by one multiplication. Below 2^-1022 the sum is first rounded to the
// subnormal grid, as 1 + y rounds y to a multiple of 2^-52, so the result
// is rounded once (ARM's specialcase).
ExpScaled(tmp: f64, sbits: u64, up: bool): f64 {
    if up {
        s := f64.FromBits(sbits -% 0x3F10000000000000) // less 1009 << 52
        return ExpUp * (s + s * tmp)
    }
    s := f64.FromBits(sbits +% 0x3FE0000000000000) // plus 1022 << 52
    var y := s + s * tmp
    if y < 1.0 {
        var lo := s - y + s * tmp
        hi := 1.0 + y
        lo = 1.0 - hi + y + lo
        y = (hi + lo) - 1.0
    }
    return ExpDown * y
}

// ExpCore is e^(x + xtail) for a finite x with 2^-54 <= |x| < 1024 and
// |xtail| <= 2^-24 |x|. ExpF32 (trans32.mk) repeats its steps for xtail =
// 0 and |x| < 88, so that they are not a call; tests_fast32.mk holds the
// two to the same bits.
ExpCore(x: f64, xtail: f64): f64 {
    kd0 := x * ExpInvLn2N + ExpShift
    ki := kd0.Bits()
    kd := kd0 - ExpShift
    // x - kd ExpLn2HiN is exact (Sterbenz) and so is the product.
    r := (x - kd * ExpLn2HiN) - kd * ExpLn2LoN + xtail
    i := Trunc[int](ki & 127) * 2
    tail := f64.FromBits(ExpT[i])
    sbits := ExpT[i + 1] +% (ki << 45)
    r2 := r * r
    tmp := tail + r + r2 * (ExpQ2 + r * ExpQ3) + r2 * r2 * (ExpQ4 + r * ExpQ5)
    if x.Bits() & AbsMask64 >= 0x4080000000000000 {
        return ExpScaled(tmp, sbits, x > 0.0) // |x| >= 512
    }
    s := f64.FromBits(sbits)
    return s + s * tmp
}

/// Exp is e^x: inf past 709.78, 0 below -745.13, Nan for a NaN. Faithfully
/// rounded (within 1 ulp) but not correctly rounded, so its results may change
/// in a minor release. TestSTDMATH_TrueError: largest error 0.502 ulp over
/// 20,243 inputs, 5 of them not correctly rounded. Over the 3,254 adversarial
/// and random inputs of TestSTDMATH_Edges, largest error 0.506 ulp. O(1);
/// allocates nothing.
export Exp(x: f64): f64 {
    b := x.Bits()
    a := b & AbsMask64
    if a < 0x3C90000000000000 {
        return 1.0 + x // |x| < 2^-54
    }
    if a >= 0x4090000000000000 {
        // |x| >= 1024, an infinity or a NaN
        if a > ExpMask64 {
            return Nan
        }
        return if b & SignBit64 != 0 { 0.0 } else { Inf }
    }
    return ExpCore(x, 0.0)
}
