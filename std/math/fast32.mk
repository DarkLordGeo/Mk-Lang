// Why: the correctly rounded f32 functions (trans32.mk) are slow in
// general; most inputs can be answered by a short f64 evaluation.
//
// What: the rounding test Rounds32, LogFast32Ulps (the bound of LogF32's
// fast kernel, which is written in LogF32 itself), SinCosFast32 with its
// bound, used by SinF32 and CosF32, and the table SinPi32T (512 bytes,
// generated by TestSTDMATH_Tables). None is exported. ExpF32 has no
// rounding test: its result is Exp's kernel's, rounded once.
//
// How: in the manner of CORE-MATH's binary32 routines (Sibidanov,
// Zimmermann and Glondu, 2022): when the f64 result y lies farther than
// the stated bound from every midpoint between two f32s, Cast[f32](y) is
// the correctly rounded result; otherwise the caller takes its slow path.
// Both paths give the same f32, so the exhaustive digests
// (TestSTDMATH_Exhaustive) stay pinned. All O(1), no allocation, no panic.

// Rounds32 says whether Cast[f32] rounds every value within e f64 ulps of y
// as it rounds y, for a y whose f32 rounding is a normal f32: an f32 keeps
// the top 23 of the 52 fraction bits, so a midpoint between two f32s of
// y's binade has 0x10000000 in the 29 bits below, and y is safe when
// those bits are more than e away from it. A relative error bound of
// 2^-n is at most 2^(53 - n) ulps of y.
Rounds32(y: f64, e: u64): bool {
    return (y.Bits() & 0x1FFFFFFF) -% (0x10000000 - e) >= 2 * e
}

// LogFast32Ulps is the bound, in ulps of its result, of LogF32's fast
// kernel (trans32.mk): 2^12, from a relative error below 2^-43.
const LogFast32Ulps: u64 = 0x1000

// Generated by TestSTDMATH_Tables (fast32): do not edit.
// SinCosFast32: 32 / pi.
const SinInvPio32: f64 = f64.FromBits(0x40245F306DC9C883)
// pi/32 to 29 bits, so n * Pio32P1 is exact for |n| < 2^24.
const Pio32P1: f64 = f64.FromBits(0x3FB921FB54000000)
// The next 29 bits of pi/32.
const Pio32P2: f64 = f64.FromBits(0x3DD10B4612000000)
// pi/32 less Pio32P1 and Pio32P2.
const Pio32P3: f64 = f64.FromBits(0xBBF676733AE8FE48)
// sin r = r + r^3 (SinF1 + r^2 (SinF2 + r^2 SinF3)), Taylor's series, truncation below 2^-57 for |r| <= pi/64; SinF1 = -1/3!.
const SinF1: f64 = f64.FromBits(0xBFC5555555555555)
// 1/5!.
const SinF2: f64 = f64.FromBits(0x3F81111111111111)
// -1/7!.
const SinF3: f64 = f64.FromBits(0xBF2A01A01A01A01A)
// cos r - 1 = r^2 (CosF1 + r^2 (CosF2 + r^2 CosF3)), Taylor's series, truncation below 2^-50 for |r| <= pi/64; CosF1 = -1/2!.
const CosF1: f64 = f64.FromBits(0xBFE0000000000000)
// 1/4!.
const CosF2: f64 = f64.FromBits(0x3FA5555555555555)
// -1/6!.
const CosF3: f64 = f64.FromBits(0xBF56C16C16C16C17)
// sin(j pi/32) for j in 0..64, exactly 0 and +-1 where it is; cos(j pi/32)
// is row (j + 16) mod 64.
const SinPi32T: [64]u64 = [
    0x0000000000000000, 0x3FB917A6BC29B42C, 0x3FC8F8B83C69A60B, 0x3FD294062ED59F06,
    0x3FD87DE2A6AEA963, 0x3FDE2B5D3806F63B, 0x3FE1C73B39AE68C8, 0x3FE44CF325091DD6,
    0x3FE6A09E667F3BCD, 0x3FE8BC806B151741, 0x3FEA9B66290EA1A3, 0x3FEC38B2F180BDB1,
    0x3FED906BCF328D46, 0x3FEE9F4156C62DDA, 0x3FEF6297CFF75CB0, 0x3FEFD88DA3D12526,
    0x3FF0000000000000, 0x3FEFD88DA3D12526, 0x3FEF6297CFF75CB0, 0x3FEE9F4156C62DDA,
    0x3FED906BCF328D46, 0x3FEC38B2F180BDB1, 0x3FEA9B66290EA1A3, 0x3FE8BC806B151741,
    0x3FE6A09E667F3BCD, 0x3FE44CF325091DD6, 0x3FE1C73B39AE68C8, 0x3FDE2B5D3806F63B,
    0x3FD87DE2A6AEA963, 0x3FD294062ED59F06, 0x3FC8F8B83C69A60B, 0x3FB917A6BC29B42C,
    0x0000000000000000, 0xBFB917A6BC29B42C, 0xBFC8F8B83C69A60B, 0xBFD294062ED59F06,
    0xBFD87DE2A6AEA963, 0xBFDE2B5D3806F63B, 0xBFE1C73B39AE68C8, 0xBFE44CF325091DD6,
    0xBFE6A09E667F3BCD, 0xBFE8BC806B151741, 0xBFEA9B66290EA1A3, 0xBFEC38B2F180BDB1,
    0xBFED906BCF328D46, 0xBFEE9F4156C62DDA, 0xBFEF6297CFF75CB0, 0xBFEFD88DA3D12526,
    0xBFF0000000000000, 0xBFEFD88DA3D12526, 0xBFEF6297CFF75CB0, 0xBFEE9F4156C62DDA,
    0xBFED906BCF328D46, 0xBFEC38B2F180BDB1, 0xBFEA9B66290EA1A3, 0xBFE8BC806B151741,
    0xBFE6A09E667F3BCD, 0xBFE44CF325091DD6, 0xBFE1C73B39AE68C8, 0xBFDE2B5D3806F63B,
    0xBFD87DE2A6AEA963, 0xBFD294062ED59F06, 0xBFC8F8B83C69A60B, 0xBFB917A6BC29B42C,
]
// End of the generated block (fast32).

// SinCosFast32Ulps is SinCosFast32's bound in ulps of its result: 2^11,
// from a relative error below 2^-44 (SinCosFast32).
const SinCosFast32Ulps: u64 = 0x800

// SinCosFast32 is sin x, or cos x when cos, for x an f32 widened to f64
// with |x| < 2^20 (SinF32 also keeps |x| >= 2^-120, so its result is a
// normal f32's), with a relative error below 2^-44. x = n
// pi/32 + r with |r| <= pi/64: n = round(x 32/pi) has |n| < 2^24, so n
// Pio32P1 and n Pio32P2 are exact, x - n Pio32P1 is exact (both are
// multiples of x's ulp or of 2^-32, and the difference is below 2^-4), and
// r has a relative error near 2^-52 while |r| is far above n Pio32P3's
// rounding (2^-91); how close an f32 below 2^20 comes to a multiple of
// pi/32 is not derived here, and the run over all 2^32 inputs
// (TestSTDMATH_Exhaustive) is what shows no input misrounds. With a = n
// pi/32 from SinPi32T, sin x = sin a + (sin a (cos r - 1) + cos a sin r)
// and cos x = cos a + (cos a (cos r - 1) - sin a sin r); the series
// truncate below 2^-57 and 2^-50. Where sin a (for sin) or cos a (for
// cos) is the exact 0 of SinPi32T, the result is +-sin r with a relative
// error near 2^-50; elsewhere |x - a| <= pi/64 keeps the
// result above sin(pi/64) > 2^-4.4 in magnitude, so the absolute error
// below 2^-49.3 is below 2^-44.9 relative.
SinCosFast32(x: f64, cos: bool): f64 {
    kd0 := x * SinInvPio32 + ExpShift
    j := Trunc[int](kd0.Bits() & 63)
    kd := kd0 - ExpShift
    r := ((x - kd * Pio32P1) - kd * Pio32P2) - kd * Pio32P3
    sa := f64.FromBits(SinPi32T[j])
    ca := f64.FromBits(SinPi32T[(j + 16) & 63])
    r2 := r * r
    sr := r + r * r2 * (SinF1 + r2 * (SinF2 + r2 * SinF3))
    cm := r2 * (CosF1 + r2 * (CosF2 + r2 * CosF3))
    if cos {
        return ca + (ca * cm - sa * sr)
    }
    return sa + (sa * cm + ca * sr)
}
