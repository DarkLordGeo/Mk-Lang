    Assert(RadixHexIs(sys, 9223372036854775816, "8000000000000008"))
    Assert(RadixHexIs(sys, 10376293541461622793, "9000000000000009"))
    Assert(RadixHexIs(sys, 11529215046068469770, "a00000000000000a"))
    Assert(RadixHexIs(sys, 12682136550675316747, "b00000000000000b"))
