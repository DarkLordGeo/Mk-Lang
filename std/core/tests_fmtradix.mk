// Why: radix digits come from a table, and every byte of every radix spec must
// still be the text the spec rules give, at every integer width.
// What: test blocks for FmtIntSpec's x, X, b and o and for FmtHex: every width
// at 0, 1, 9, 10, 15, 16, its maximum and, signed, -1, -9, -10, -15, -16 and
// its minimum, under sign, zero, width, fill and align.
// How: the expected texts come from a Go model of the spec rules
// (strconv.FormatUint of the value's bits at its width), written in once.

// RadixU8 is v under every spec of these blocks, joined by |.
RadixU8(ar: &Arena, v: u8): OutOfMemory!str from ar {
    return try ar.Fmt("{v:x}|{v:X}|{v:b}|{v:o}|{v:06x}|{v:010X}|{v:020o}|{v:012b}|{v:08o}|{v:6x}|{v:<10X}|{v:^11o}|{v:*>20b}|{v:#<70b}|{v:-^9x}", (v))
}

