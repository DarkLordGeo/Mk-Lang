// RadixHexIs is whether FmtHex writes exactly want for x.
RadixHexIs(sys: &System, x: u64, want: str): bool {
    var t := Text.New(sys.arena)
    var w := t.Writer()
    FmtHex(mut w, x).Must()
    return t.Str() == want
}

test "FmtHex writes every digit value in lowercase, no prefix and no leading zero" (sys: &System) {
    Assert(RadixHexIs(sys, 0, "0"))
    Assert(RadixHexIs(sys, 1, "1"))
    Assert(RadixHexIs(sys, 9, "9"))
    Assert(RadixHexIs(sys, 10, "a"))
    Assert(RadixHexIs(sys, 15, "f"))
    Assert(RadixHexIs(sys, 16, "10"))
    Assert(RadixHexIs(sys, 255, "ff"))
    Assert(RadixHexIs(sys, 256, "100"))
    Assert(RadixHexIs(sys, 81985529216486895, "123456789abcdef"))
    Assert(RadixHexIs(sys, 18364758544493064720, "fedcba9876543210"))
    Assert(RadixHexIs(sys, 176685338322165, "a0b1c2d3e4f5"))
    Assert(RadixHexIs(sys, 9223372036854775808, "8000000000000000"))
    Assert(RadixHexIs(sys, 18446744073709551615, "ffffffffffffffff"))
    Assert(RadixHexIs(sys, 0, "0"))
    Assert(RadixHexIs(sys, 1152921504606846977, "1000000000000001"))
    Assert(RadixHexIs(sys, 2305843009213693954, "2000000000000002"))
    Assert(RadixHexIs(sys, 3458764513820540931, "3000000000000003"))
