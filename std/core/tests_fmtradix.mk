// RadixInt is v under every spec of these blocks, joined by |.
RadixInt(ar: &Arena, v: int): OutOfMemory!str from ar {
    return try ar.Fmt("{v:x}|{v:X}|{v:b}|{v:o}|{v:06x}|{v:010X}|{v:020o}|{v:012b}|{v:08o}|{v:6x}|{v:<10X}|{v:^11o}|{v:*>20b}|{v:#<70b}|{v:-^9x}", (v))
}

