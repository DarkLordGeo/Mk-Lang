// x509-verify-chain, Mk: std.x509 parsing and path validation of a
// three-certificate chain (std/x509/testdata's chain.pem and root.pem: a
// P-256 leaf signed by ECDSA-SHA384 under a P-384 intermediate, signed by
// ECDSA-SHA256 under a P-256 root). <reps> passes each parse the three
// certificates from DER and verify the leaf for example.test at
// 2024-01-01T00:00:00Z against a pool of the root. Prints how many passes
// verified. Usage: x509-verify-chain <reps>.

import std.time
import std.x509

const LeafHex: str = ""
const InterHex: str = ""
const RootHex: str = ""

Nib(c: u8): u8 {
    if c >= b'a' {
        return c - 87
    }
    return c - 48
}

Unhex(a: &Arena, s: str): OutOfMemory![]u8 from a {
    b := s.AsBytes()
    out := try a.Slice[u8](b.Len() / 2)
    for i in 0..out.Len() {
        out[i] = (Nib(b[2 * i]) << 4) | Nib(b[2 * i + 1])
    }
    return out[..]
}

export Main(sys: &System): OutOfMemory|ParseError|WriteError|x509.Error!void {
    reps := try sys.args[1].ParseInt()
    leaf := try Unhex(sys.arena, LeafHex)
    inter := try Unhex(sys.arena, InterHex)
    root := try Unhex(sys.arena, RootHex)
    now := time.FromUnix(1_704_067_200, 0)
    var a := try Arena.New(sys.heap)
    defer a.Free()
    var ok := 0
    for _ in 0..reps {
        // Local arrays, not Lists in `a`: a certificate holds a loan of
        // `a`, and a List's storage is the arena's own memory, which the
        // checker counts as reaching `*sys` (E0505).
        chain := [try x509.Parse(&a, leaf), try x509.Parse(&a, inter)]
        roots := [try x509.Parse(&a, root)]
        pool := x509.Pool.New(roots[..])
        var good := true
        x509.Verify(&a, sys.io, chain[..], &pool, now, "example.test") else {
            good = false
        }
        if good {
            ok += 1
        }
        a.Reset()
    }
    try sys.Print("{ok}\n", (ok))
}
