export Main(sys: &System): OutOfMemory|ParseError|WriteError|x509.Error!void {
    reps := try sys.args[1].ParseInt()
    var a := try Arena.New(sys.heap)
    defer a.Free()
    var sum: i64 = 0
    for _ in 0..reps {
        certs := try x509.ParsePem(&a, Bundle)
        for i in 0..certs.Len() {
            sum += i64(certs[i].Der().Len())
        }
        a.Reset()
    }
    try sys.Print("{sum}\n", (sum))
}
