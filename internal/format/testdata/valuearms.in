Sign(n: i32): i32 {
return if n<0 {-1} else if n==0 {0} else {1}
}

Name(s: Shape, c: bool): str {
  kind := match s {
  .Circle {"circle"}
      .Rect(w, h) {
   if w == h {"square"} else {"rect"}
      }
  .Empty { return "nothing" }
  }
  F(if c {
  1
  } else {
  2
  }, 3)
  r := (a: match c {
  true { 1 }
  false { 2 }
  }, b: 3)
  xs := [0, if c {
  1
  } else {
  2
  }]
    x = if c { 1 } else { 2 }
  return kind
}

Total(m: &Map[str, int], xs: [](a: int, b: int)): int {
  var sum := 0
  for (key, value) in m.Iter() {
  sum += *value
  }
  for i, (a, b) in xs {
  sum += i
  }
  return sum
}

Port(text: str): i64 {
  n := text.ParseInt() else e {
  _ = e
  8080
  }
  return n
}
