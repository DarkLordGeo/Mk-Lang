struct Big {
    bulk: ?&Bulk
    g: ?&B[int]
}

var GW: Big = Big(bulk: none, g: none)

Pick(x: &i32): &Big from x {
    return &GW
}

export Main(sys: &System) {
    n: i32 = 7
    w := Pick(&n)
    if x := w.g {
        _ = x
        sys.Print("some\n") else {}
    } else {
        sys.Print("none\n") else {}
    }
}
