b1:
  %v10 = load i8, ptr %v3, align 1, !noundef !5, !dbg !21
  %v11 = load i8, ptr %v4, align 1, !noundef !5, !dbg !21
  %v12 = icmp ult i8 %v10, %v11, !dbg !21
  %v13 = zext i1 %v12 to i8, !dbg !21
  store i8 %v13, ptr %v5, align 1, !dbg !21
  %v14 = load i8, ptr %v5, align 1, !range !13, !noundef !5, !dbg !20
  %v15 = trunc i8 %v14 to i1, !dbg !20
  br i1 %v15, label %b2, label %b3, !dbg !20

b2:
  %v16 = load i8, ptr %v3, align 1, !noundef !5, !dbg !22
  %v17 = add nuw i8 %v16, 1, !dbg !22
  store i8 %v17, ptr %v3, align 1, !dbg !22
