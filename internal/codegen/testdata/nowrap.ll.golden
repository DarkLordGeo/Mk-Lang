b3:
  %v18 = load i8, ptr %v3, align 1, !noundef !5, !dbg !23
  %v19 = zext i8 %v18 to i64, !dbg !23
  store i64 %v19, ptr %v0, align 8, !dbg !23
  %v20 = load i64, ptr %v0, align 8, !noundef !5, !dbg !23
  ret i64 %v20, !dbg !23
