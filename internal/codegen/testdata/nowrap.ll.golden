source_filename = "mk.main.CountI8"
target triple = "x86_64-unknown-linux-gnu"

@mk.fr.mk.main.CountI8 = private constant { ptr, ptr, i32 } { ptr @mk.main.CountI8, ptr null, i32 0 }, section "mk_funcs", align 8, !associated !40
