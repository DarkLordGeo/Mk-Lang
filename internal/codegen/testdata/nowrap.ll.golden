define hidden noundef i64 @mk.main.CountI8(i64 noundef %p0, i64 noundef %p1) nounwind uwtable "probe-stack"="inline-asm" "stack-probe-size"="4096" !dbg !7 {
entry:
  %v0 = alloca [8 x i8], align 8, !dbg !8
  %v1 = alloca [8 x i8], align 8, !dbg !8
  %v2 = alloca [8 x i8], align 8, !dbg !8
  %v3 = alloca [1 x i8], align 1, !dbg !8
  %v4 = alloca [1 x i8], align 1, !dbg !8
  %v5 = alloca [1 x i8], align 1, !dbg !8
  store i64 %p0, ptr %v1, align 8, !dbg !8
  store i64 %p1, ptr %v2, align 8, !dbg !8
  br label %b0, !dbg !8

b0:
  %v6 = load i64, ptr %v1, align 8, !noundef !5, !dbg !9
  %v7 = trunc i64 %v6 to i8, !dbg !9
  store i8 %v7, ptr %v3, align 1, !dbg !9
  %v8 = load i64, ptr %v2, align 8, !noundef !5, !dbg !10
  %v9 = trunc i64 %v8 to i8, !dbg !10
  store i8 %v9, ptr %v4, align 1, !dbg !10
  br label %b1, !dbg !11

b1:
  %v10 = load i8, ptr %v3, align 1, !noundef !5, !dbg !12
  %v11 = load i8, ptr %v4, align 1, !noundef !5, !dbg !12
  %v12 = icmp slt i8 %v10, %v11, !dbg !12
  %v13 = zext i1 %v12 to i8, !dbg !12
  store i8 %v13, ptr %v5, align 1, !dbg !12
  %v14 = load i8, ptr %v5, align 1, !range !13, !noundef !5, !dbg !11
  %v15 = trunc i8 %v14 to i1, !dbg !11
  br i1 %v15, label %b2, label %b3, !dbg !11

b2:
  %v16 = load i8, ptr %v3, align 1, !noundef !5, !dbg !14
  %v17 = add nsw i8 %v16, 1, !dbg !14
  store i8 %v17, ptr %v3, align 1, !dbg !14
  br label %b1, !dbg !14

b3:
  %v18 = load i8, ptr %v3, align 1, !noundef !5, !dbg !15
  %v19 = sext i8 %v18 to i64, !dbg !15
  store i64 %v19, ptr %v0, align 8, !dbg !15
  %v20 = load i64, ptr %v0, align 8, !noundef !5, !dbg !15
  ret i64 %v20, !dbg !15
}

define hidden noundef i64 @mk.main.CountU8(i64 noundef %p0, i64 noundef %p1) nounwind uwtable "probe-stack"="inline-asm" "stack-probe-size"="4096" !dbg !16 {
