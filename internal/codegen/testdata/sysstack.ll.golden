source_filename = "mk.main.CallBig"
target triple = "x86_64-unknown-linux-gnu"

@mk.fr.mk.main.CallBig = private constant { ptr, ptr, i32 } { ptr @mk.main.CallBig, ptr null, i32 0 }, section "mk_funcs", align 8, !associated !23
@mk.fr.mk.main.CallVar = private constant { ptr, ptr, i32 } { ptr @mk.main.CallVar, ptr null, i32 0 }, section "mk_funcs", align 8, !associated !24
@mk.fr.mk.main.CallStd = private constant { ptr, ptr, i32 } { ptr @mk.main.CallStd, ptr null, i32 0 }, section "mk_funcs", align 8, !associated !25
@mk.fr.mk.cs.BigStack = private constant { ptr, ptr, i32 } { ptr @mk.cs.BigStack, ptr null, i32 2 }, section "mk_funcs", align 8, !associated !26
@mk.fr.mk.cs.Printf = private constant { ptr, ptr, i32 } { ptr @mk.cs.Printf, ptr null, i32 2 }, section "mk_funcs", align 8, !associated !27
@llvm.compiler.used = appending global [5 x ptr] [ptr @mk.fr.mk.main.CallBig, ptr @mk.fr.mk.main.CallVar, ptr @mk.fr.mk.main.CallStd, ptr @mk.fr.mk.cs.BigStack, ptr @mk.fr.mk.cs.Printf], section "llvm.metadata"

define hidden noundef i64 @mk.main.CallBig(i64 noundef %p0) nounwind uwtable "probe-stack"="inline-asm" "stack-probe-size"="4096" !dbg !7 {
entry:
  %v0 = alloca [8 x i8], align 8, !dbg !8
  %v1 = alloca [8 x i8], align 8, !dbg !8
  store i64 %p0, ptr %v1, align 8, !dbg !8
  %v3 = alloca [8 x i8], align 8, !dbg !8
  %v8 = alloca [16 x i8], align 8, !dbg !8
  br label %b0, !dbg !8

b0:
  %v2 = load i64, ptr %v1, align 8, !noundef !5, !dbg !9
  %v4 = call noundef ptr @mk.std.task.SystemStack() nounwind, !dbg !9
  store ptr %v4, ptr %v3, align 8, !dbg !9
  %v5 = load ptr, ptr %v3, align 8, !noundef !5, !dbg !9
  %v6 = icmp eq ptr %v5, null, !dbg !9
  br i1 %v6, label %x1, label %x2, !dbg !9

b1:
  %v11 = load i64, ptr %v0, align 8, !noundef !5, !dbg !12
  ret i64 %v11, !dbg !12

x1:
  %v7 = call noundef i64 @BigStack(i64 noundef %v2) nounwind, !dbg !9
  store i64 %v7, ptr %v0, align 8, !dbg !9
  br label %x3, !dbg !9

x2:
  store i64 %v2, ptr %v8, align 8, !dbg !9
  call void @mk_call_system(ptr @mk.cs.BigStack, ptr %v8, ptr %v5) nounwind, !dbg !9
  call void @mk.std.task.SystemStackDone() nounwind, !dbg !9
  %v9 = getelementptr inbounds i8, ptr %v8, i64 8, !dbg !9
  %v10 = load i64, ptr %v9, align 8, !noundef !5, !dbg !9
  store i64 %v10, ptr %v0, align 8, !dbg !9
  br label %x3, !dbg !9

x3:
  br label %b1, !dbg !9
}

define hidden noundef i32 @mk.main.CallVar(ptr noundef %p0) nounwind uwtable "probe-stack"="inline-asm" "stack-probe-size"="4096" !dbg !13 {
entry:
  %v0 = alloca [4 x i8], align 4, !dbg !14
  %v1 = alloca [8 x i8], align 8, !dbg !14
  store ptr %p0, ptr %v1, align 8, !dbg !14
  %v3 = alloca [8 x i8], align 8, !dbg !14
  %v8 = alloca [28 x i8], align 8, !dbg !14
  br label %b0, !dbg !14

b0:
  %v2 = load ptr, ptr %v1, align 8, !dbg !15
  %v4 = call noundef ptr @mk.std.task.SystemStack() nounwind, !dbg !15
  store ptr %v4, ptr %v3, align 8, !dbg !15
  %v5 = load ptr, ptr %v3, align 8, !noundef !5, !dbg !15
  %v6 = icmp eq ptr %v5, null, !dbg !15
  br i1 %v6, label %x1, label %x2, !dbg !15

b1:
  %v13 = load i32, ptr %v0, align 4, !noundef !5, !dbg !18
  ret i32 %v13, !dbg !18

x1:
  %v7 = call noundef i32 (ptr, ...) @Printf(ptr noundef %v2, i64 noundef 1, double noundef 0x4004000000000000) nounwind, !dbg !15
  store i32 %v7, ptr %v0, align 4, !dbg !15
  br label %x3, !dbg !15

x2:
  store ptr %v2, ptr %v8, align 8, !dbg !15
  %v9 = getelementptr inbounds i8, ptr %v8, i64 8, !dbg !15
  store i64 1, ptr %v9, align 8, !dbg !15
  %v10 = getelementptr inbounds i8, ptr %v8, i64 16, !dbg !15
  store double 0x4004000000000000, ptr %v10, align 8, !dbg !15
  call void @mk_call_system(ptr @mk.cs.Printf, ptr %v8, ptr %v5) nounwind, !dbg !15
  call void @mk.std.task.SystemStackDone() nounwind, !dbg !15
  %v11 = getelementptr inbounds i8, ptr %v8, i64 24, !dbg !15
  %v12 = load i32, ptr %v11, align 4, !noundef !5, !dbg !15
  store i32 %v12, ptr %v0, align 4, !dbg !15
  br label %x3, !dbg !15

x3:
  br label %b1, !dbg !15
}

define hidden noundef i64 @mk.main.CallStd(i64 noundef %p0) nounwind uwtable "probe-stack"="inline-asm" "stack-probe-size"="4096" !dbg !19 {
entry:
  %v0 = alloca [8 x i8], align 8, !dbg !20
  %v1 = alloca [8 x i8], align 8, !dbg !20
  store i64 %p0, ptr %v1, align 8, !dbg !20
  br label %b0, !dbg !20

b0:
  %v2 = load i64, ptr %v1, align 8, !noundef !5, !dbg !21
  %v3 = call noundef i64 @Raw(i64 noundef %v2) nounwind, !dbg !21
  store i64 %v3, ptr %v0, align 8, !dbg !21
  br label %b1, !dbg !21

b1:
  %v4 = load i64, ptr %v0, align 8, !noundef !5, !dbg !22
  ret i64 %v4, !dbg !22
}

declare noundef i64 @BigStack(i64 noundef) nounwind

declare hidden noundef ptr @mk.std.task.SystemStack() nounwind

define internal void @mk.cs.BigStack(ptr noundef %p0) nounwind uwtable "probe-stack"="inline-asm" "stack-probe-size"="4096" !dbg !10 {
entry:
  br label %x1, !dbg !11

x1:
  %v0 = load i64, ptr %p0, align 8, !noundef !5, !dbg !11
  %v1 = getelementptr inbounds i8, ptr %p0, i64 8, !dbg !11
  %v2 = call noundef i64 @BigStack(i64 noundef %v0) nounwind, !dbg !11
  store i64 %v2, ptr %v1, align 8, !dbg !11
  ret void, !dbg !11
}

declare void @mk_call_system(ptr, ptr, ptr) nounwind

declare hidden void @mk.std.task.SystemStackDone() nounwind

declare noundef i32 @Printf(ptr noundef, ...) nounwind

define internal void @mk.cs.Printf(ptr noundef %p0) nounwind uwtable "probe-stack"="inline-asm" "stack-probe-size"="4096" !dbg !16 {
entry:
  br label %x1, !dbg !17

x1:
  %v0 = load ptr, ptr %p0, align 8, !dbg !17
  %v1 = getelementptr inbounds i8, ptr %p0, i64 8, !dbg !17
  %v2 = load i64, ptr %v1, align 8, !noundef !5, !dbg !17
  %v3 = getelementptr inbounds i8, ptr %p0, i64 16, !dbg !17
  %v4 = load double, ptr %v3, align 8, !noundef !5, !dbg !17
  %v5 = getelementptr inbounds i8, ptr %p0, i64 24, !dbg !17
  %v6 = call noundef i32 (ptr, ...) @Printf(ptr noundef %v0, i64 noundef %v2, double noundef %v4) nounwind, !dbg !17
  store i32 %v6, ptr %v5, align 4, !dbg !17
  ret void, !dbg !17
}

declare noundef i64 @Raw(i64 noundef) nounwind

