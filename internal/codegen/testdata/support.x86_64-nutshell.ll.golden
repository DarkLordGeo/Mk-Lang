@mk.fr.mk.support.udivti3 = private constant { ptr, ptr, i32 } { ptr @mk.support.udivti3, ptr null, i32 2 }, section "mk_funcs", align 8, !associated !0
@mk.fr.mk.support.umodti3 = private constant { ptr, ptr, i32 } { ptr @mk.support.umodti3, ptr null, i32 2 }, section "mk_funcs", align 8, !associated !1
@mk.fr.mk.support.divti3 = private constant { ptr, ptr, i32 } { ptr @mk.support.divti3, ptr null, i32 2 }, section "mk_funcs", align 8, !associated !2
@mk.fr.mk.support.modti3 = private constant { ptr, ptr, i32 } { ptr @mk.support.modti3, ptr null, i32 2 }, section "mk_funcs", align 8, !associated !3
@llvm.used = appending global [5 x ptr] [ptr @memcpy, ptr @memmove, ptr @memset, ptr @memcmp, ptr @bcmp], section "llvm.metadata"
@llvm.compiler.used = appending global [4 x ptr] [ptr @mk.fr.mk.support.udivti3, ptr @mk.fr.mk.support.umodti3, ptr @mk.fr.mk.support.divti3, ptr @mk.fr.mk.support.modti3], section "llvm.metadata"

@__udivti3 = weak alias i128 (i128, i128), ptr @mk.support.udivti3
@__umodti3 = weak alias i128 (i128, i128), ptr @mk.support.umodti3
@__divti3 = weak alias i128 (i128, i128), ptr @mk.support.divti3
@__modti3 = weak alias i128 (i128, i128), ptr @mk.support.modti3

