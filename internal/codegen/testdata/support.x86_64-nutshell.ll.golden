source_filename = "mk.support"
target triple = "x86_64-unknown-nutshell-elf"

module asm "\09.text"
module asm "\09.globl _start"
module asm "\09.type _start,@function"
module asm "\09.p2align 4"
module asm "_start:"
module asm "\09.cfi_startproc"
module asm "\09.cfi_undefined %rip"
module asm "\09pushq %rsi"
