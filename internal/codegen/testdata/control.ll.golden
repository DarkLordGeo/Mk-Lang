!12 = !DILocation(line: 2, column: 20, scope: !7)
!13 = !DILocation(line: 3, column: 5, scope: !7)
!14 = distinct !DISubprogram(name: "main.Pick", linkageName: "mk.main.Pick", scope: !4, file: !4, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !3)
!15 = !DILocation(line: 1, column: 1, scope: !14)
!16 = !DILocation(line: 6, column: 3, scope: !14)
!17 = !DILocation(line: 7, column: 3, scope: !14)
