!19 = !DILocation(line: 1, column: 1, scope: !18)
!20 = !DILocation(line: 9, column: 3, scope: !18)
!21 = !{i8 -56, i8 -55, i8 0, i8 2}
!22 = distinct !DISubprogram(name: "main.Stop", linkageName: "mk.main.Stop", scope: !4, file: !4, line: 1, type: !6, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !3)
!23 = !DILocation(line: 1, column: 1, scope: !22)
!24 = !DILocation(line: 11, column: 3, scope: !22)
!25 = !{ptr @mk.main.Max}
!26 = !{ptr @mk.main.Pick}
!27 = !{ptr @mk.main.Load}
!28 = !{ptr @mk.main.Stop}
