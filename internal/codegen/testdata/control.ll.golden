source_filename = "mk.main.Max"
target triple = "x86_64-unknown-linux-gnu"

@mk.s.1 = private unnamed_addr constant [9 x i8] c"main/t.mk", align 1
@mk.pos.mk.main.Stop.0 = private unnamed_addr constant { ptr, i64, i32, i32 } { ptr @mk.s.1, i64 9, i32 11, i32 3 }, align 8
@mk.fr.mk.main.Max = private constant { ptr, ptr, i32 } { ptr @mk.main.Max, ptr null, i32 0 }, section "mk_funcs", align 8, !associated !25
@mk.fr.mk.main.Pick = private constant { ptr, ptr, i32 } { ptr @mk.main.Pick, ptr null, i32 0 }, section "mk_funcs", align 8, !associated !26
@mk.fr.mk.main.Load = private constant { ptr, ptr, i32 } { ptr @mk.main.Load, ptr null, i32 0 }, section "mk_funcs", align 8, !associated !27
@mk.fr.mk.main.Stop = private constant { ptr, ptr, i32 } { ptr @mk.main.Stop, ptr null, i32 0 }, section "mk_funcs", align 8, !associated !28
@llvm.compiler.used = appending global [4 x ptr] [ptr @mk.fr.mk.main.Max, ptr @mk.fr.mk.main.Pick, ptr @mk.fr.mk.main.Load, ptr @mk.fr.mk.main.Stop], section "llvm.metadata"

define hidden noundef i64 @mk.main.Max(i64 noundef %p0, i64 noundef %p1) nounwind uwtable "probe-stack"="inline-asm" "stack-probe-size"="4096" !dbg !7 {
entry:
  %v0 = alloca [8 x i8], align 8, !dbg !8
  %v1 = alloca [8 x i8], align 8, !dbg !8
  %v2 = alloca [8 x i8], align 8, !dbg !8
  %v3 = alloca [1 x i8], align 1, !dbg !8
  store i64 %p0, ptr %v1, align 8, !dbg !8
  store i64 %p1, ptr %v2, align 8, !dbg !8
  br label %b0, !dbg !8

b0:
  %v4 = load i64, ptr %v1, align 8, !noundef !5, !dbg !9
  %v5 = load i64, ptr %v2, align 8, !noundef !5, !dbg !9
  %v6 = icmp slt i64 %v4, %v5, !dbg !9
  %v7 = zext i1 %v6 to i8, !dbg !9
  store i8 %v7, ptr %v3, align 1, !dbg !9
  %v8 = load i8, ptr %v3, align 1, !range !11, !noundef !5, !dbg !10
  %v9 = trunc i8 %v8 to i1, !dbg !10
  br i1 %v9, label %b1, label %b2, !dbg !10

b1:
  %v10 = load i64, ptr %v2, align 8, !noundef !5, !dbg !12
  store i64 %v10, ptr %v0, align 8, !dbg !12
  br label %b3, !dbg !12

b2:
  %v11 = load i64, ptr %v1, align 8, !noundef !5, !dbg !13
  store i64 %v11, ptr %v0, align 8, !dbg !13
  br label %b3, !dbg !13

b3:
  %v12 = load i64, ptr %v0, align 8, !noundef !5, !dbg !13
  ret i64 %v12, !dbg !13
}

define hidden noundef i64 @mk.main.Pick(i8 noundef zeroext %p0) nounwind uwtable "probe-stack"="inline-asm" "stack-probe-size"="4096" !dbg !14 {
entry:
  %v0 = alloca [8 x i8], align 8, !dbg !15
  %v1 = alloca [1 x i8], align 1, !dbg !15
  %v2 = alloca [8 x i8], align 8, !dbg !15
  store i8 %p0, ptr %v1, align 1, !dbg !15
  br label %b0, !dbg !15

b0:
  %v3 = load i8, ptr %v1, align 1, !noundef !5, !dbg !16
  %v4 = zext i8 %v3 to i64, !dbg !16
  store i64 %v4, ptr %v2, align 8, !dbg !16
  %v5 = load i64, ptr %v2, align 8, !noundef !5, !dbg !16
  switch i64 %v5, label %x1 [
    i64 0, label %b1
    i64 1, label %b2
    i64 200, label %b3
  ], !dbg !16

b1:
  store i64 1, ptr %v0, align 8, !dbg !17
  %v6 = load i64, ptr %v0, align 8, !noundef !5, !dbg !17
  ret i64 %v6, !dbg !17

b2:
  store i64 2, ptr %v0, align 8, !dbg !17
  %v7 = load i64, ptr %v0, align 8, !noundef !5, !dbg !17
  ret i64 %v7, !dbg !17

b3:
  store i64 3, ptr %v0, align 8, !dbg !17
  %v8 = load i64, ptr %v0, align 8, !noundef !5, !dbg !17
  ret i64 %v8, !dbg !17

x1:
  unreachable, !dbg !16
}

define hidden noundef zeroext i8 @mk.main.Load(ptr noundef nonnull align 1 dereferenceable(1) noalias readonly %p0) nounwind uwtable "probe-stack"="inline-asm" "stack-probe-size"="4096" !dbg !18 {
entry:
  %v0 = alloca [1 x i8], align 1, !dbg !19
  %v1 = alloca [8 x i8], align 8, !dbg !19
  store ptr %p0, ptr %v1, align 8, !dbg !19
  br label %b0, !dbg !19

b0:
  %v2 = load ptr, ptr %v1, align 8, !nonnull !5, !noundef !5, !dbg !20
  %v3 = load i8, ptr %v2, align 1, !range !21, !noundef !5, !dbg !20
  store i8 %v3, ptr %v0, align 1, !dbg !20
  %v4 = load i8, ptr %v0, align 1, !range !21, !noundef !5, !dbg !20
  ret i8 %v4, !dbg !20
}

define hidden void @mk.main.Stop() nounwind uwtable noreturn "probe-stack"="inline-asm" "stack-probe-size"="4096" !dbg !22 {
entry:
  br label %b0, !dbg !23

b0:
  call void @mk.std.rt.PanicAt(i32 noundef 15, ptr noundef nonnull align 1 dereferenceable(1) noalias readonly @mk.pos.mk.main.Stop.0) nounwind noreturn cold, !dbg !24
  unreachable, !dbg !24
}

declare hidden void @mk.std.rt.PanicAt(i32 noundef, ptr noundef nonnull align 1 dereferenceable(1) noalias readonly) nounwind noreturn cold

!llvm.dbg.cu = !{!3}
!llvm.module.flags = !{!0, !1}
