    return Fp(a: x, b: y)
}

H1(var k: i64, r1: &i64, dp2: mut Deep): &i64 from r1 {
    var h: i64 = 0
    h = h *% 31 +% *dp2.a
    k = k *% 6364136223846793005 +% 1442695040888963407
    if ((k >> 33) & 1) == 1 {
        h = h *% 31 +% *dp2.a
        h = h *% 31 +% *r1
    } else {
        h = h *% 31 +% *r1
        h = h *% 31 +% *dp2.a
        h = h *% 31 +% *r1
    }
    h = h *% 31 +% *r1
    h = h *% 31 +% *dp2.a
    return Pick(k ^ 1, r1, Id(r1))
}

H2(k: i64, c1: &Cell[&i64], dp2: mut Deep, e3: &D2): &i64 from dp2 {
    var h: i64 = 0
    h = h *% 31 +% *dp2.a
    h = h *% 31 +% *dp2.a
    h = h *% 31 +% *dp2.a
    h = h *% 31 +% *H1(k ^ 1, e3.a, dp2)
    h = h *% 31 +% *H1(k ^ 2, c1.Load(), dp2)
    return c1.Load()
}

export Run(k: i64): i64 {
    var h: i64 = 0
    var v1: i64 = 24
    var v2: i64 = 0
    var cs3: [2]Ct = [Ct(n: if ((k >> 51) & 1) == 1 { v2 } else { v2 }), Ct(n: 31)]
    var zc4 := mut cs3[..]
    zc4[0].Add(45)
    var r5 := FpMk(match (k >> 25) & 3 {
            0 { &v1 }
            1 { &v1 }
            _ { &v1 }
        }, &v1).b
    Swap2(mut r5, mut r5)
    c6 := Cell.New(&v1)
    Swap(mut r5, mut r5)
    var v7: i64 = if ((k >> 36) & 1) == 1 { return h } else { if ((k >> 62) & 1) == 1 { 38 } else { *Hold(&c6) } }
    var q8 := mut r5
    r5 = if ((k >> 21) & 1) == 1 { c6.Load() } else { &v7 }
    var v9: i64 = if ((k >> 32) & 1) == 1 { 23 } else { *Hold(&c6) }
    var xs10: [4]i64 = [21, 90, 3, 31]
    for x11 in mut xs10 {
        *x11 = *x11 +% 1
        var v12: i64 = 71
        var e13 := D2(a: &v9, c: &c6)
        var v14: i64 = 50
        h = h *% 31 +% v14
        h = h *% 31 +% *e13.a
        h = h *% 31 +% v12
    }
    h = h *% 31 +% xs10[0] +% xs10[1] +% xs10[2] +% xs10[3]
    h = h *% 31 +% v9
    h = h *% 31 +% **q8
    h = h *% 31 +% v7
    h = h *% 31 +% *c6.Load()
    h = h *% 31 +% cs3[0].n +% cs3[1].n
    h = h *% 31 +% v2
    h = h *% 31 +% v1
    h = h *% 31 +% k
    return h
}
