# The loopback origin most cases use. Run with: fetch --origin site.origin URL
route GET /hello
header Content-Type: text/plain
body hello, world\n

route * /echo
echo

route GET /missing
status 404
body no such page\n

route GET /fail
status 503
body try again later\n

route * /redirect/301
status 301
header Location: /echo
route * /redirect/302
status 302
header Location: /echo
route * /redirect/303
status 303
header Location: /echo
route * /redirect/307
status 307
header Location: /echo
route * /redirect/308
status 308
header Location: /echo
route GET /redirect/loop
status 302
header Location: /redirect/loop
route GET /redirect/away
status 302
header Location: http://{origin2}/echo
route GET /redirect/same
status 302
header Location: /echo

route GET /cookies/set
header Set-Cookie: session=abc123; Path=/; HttpOnly
header Set-Cookie: scoped=1
header Set-Cookie: keep=1; Expires=Fri, 01 Jan 2100 00:00:00 GMT; Path=/
header Set-Cookie: old=gone; Expires=Sun, 06 Nov 1994 08:49:37 GMT
header Set-Cookie: brief=x; Max-Age=0
header Set-Cookie: hour=1; Max-Age=3600; Path=/
header Set-Cookie: elsewhere=no; Domain=example.com
body cookies set\n

route GET /gzip
gzip
header Content-Type: text/plain
repeat 20 gzip body line\n
route GET /deflate
zlib
repeat 20 deflate body line\n
route GET /zstd
header Content-Encoding: zstd
file www/hello.zst

route GET /big
ranges
repeat 40000 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde\n
route GET /flaky
ranges
cut-unranged 70000
repeat 4000 the quick brown fox jumps over the lazy dog, again and again!\n
route GET /cut
cut 100
repeat 100 this line will not all arrive\n
route GET /stall
stall
route GET /chunked
chunked
repeat 300 chunk\n
route GET /dated
modified Sat, 01 Jan 2022 00:00:00 GMT
body dated body\n
route GET /cookies/echo
echo

route GET /ws
websocket
