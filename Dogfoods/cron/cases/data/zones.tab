# Jobs at local times that the 2026 transitions of three zones skip or repeat
CRON_TZ=Europe/Berlin
30 2 * * *     nightly   timeout=5m  --  jobkit print nightly
0 * 29 3 *     hourly                --  jobkit print hourly
CRON_TZ=America/New_York
30 1 * * sun   early                 --  jobkit print early
CRON_TZ=Australia/Lord_Howe
45 1 * * *     howe-back             --  jobkit print howe
15 2 * * *     howe-fwd              --  jobkit print howe
