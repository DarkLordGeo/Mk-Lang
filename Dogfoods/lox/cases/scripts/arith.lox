// Numbers, strings, booleans and nil: operators, precedence and printing.
print 1 + 2 * 3;
print (1 + 2) * 3;
print 10 / 4;
print -3 - -4;
print 7 % 3;
print -7 % 3;
print 0.1 + 0.2;
print 1 / 3;
print 1000000 * 1000000 * 1000000 * 1000;
print 123456789012;
print 2 * 0.5;
print 1 < 2;
print 2 <= 2;
print 3 > 4;
print 3 >= 4;
print 1 == 1;
print 1 != 1;
print "a" == "a";
print "a" == "b";
print nil == nil;
print nil == false;
print 1 == "1";
print !nil;
print !0;
print !"";
print true and "yes";
print false and "never";
print nil or "fallback";
print "first" or "second";
print "con" + "cat" + "enate";
print -(2 + 3);
