// Why: The batch and load modes drive the server with many requests, from a
// script or from concurrent tasks.
//
// What: Tally, Plan, Script, Load and Drive.
//
// How: Script runs commands in order, each in its own sub-arena. Load starts
// one task per client, each posting its notes and counting outcomes into its
// own Tally, and sums the tallies after the join.

import std.derive

/// What one load client counted.
export struct Tally {
    export created: int
    export refused: int
    export failed: int
}

gen derive.Eq(Tally)

/// How much load to put on the server: `clients` tasks at once, each sending
/// `requests` new notes.
export struct Plan {
    export clients: int
    export requests: int
}

gen derive.Format(Plan)

/// Runs each command of `script` in order through the session, stopping at
/// the first that fails with an error, which it reports with exit code 1, or 2
/// for a usage error. Each command gets its own sub-arena.
export Script(heap: &Heap, io: Io, session: mut Session, script: [][]str) {
    var arena := Arena.New(heap) else {
        session.code = 1
        return
    }
    defer arena.Free()
    al := heap.Alloc()
    for words in script {
        var scratch := arena.Sub() else {
            session.code = 1
            return
        }
        defer scratch.Free()
        session.Run(&scratch, io, al, words) else e {
            Report(&scratch, al, session, words, e)
            return
        }
    }
}

/// Puts `plan`'s load on the server: every client task posts its notes, each
/// with its own title and the tag `load`, and the counts are summed after the
/// join. Prints the totals into the session, then runs `stats`.
export Load(heap: &Heap, io: Io, session: mut Session, plan: Plan) {
    var arena := Arena.New(heap) else {
        session.code = 1
        return
    }
    defer arena.Free()
    al := heap.Alloc()
    tallies := arena.Slice[Tally](plan.clients) else {
        session.code = 1
        return
    }
    var client := 0
    scope s := io.Scope() {
        for piece in tallies.ChunksMut(1) {
            s.go Post(heap, io, session.base, session.attempts, client, plan.requests, piece)
            client += 1
        }
    }
    var sum := Tally(created: 0, refused: 0, failed: 0)
    for t in tallies[..] {
        sum.created += t.created
        sum.refused += t.refused
        sum.failed += t.failed
    }
    text := arena.Fmt("load {plan}: {sum.created} created, {sum.refused} refused, {sum.failed} failed\n", (plan, sum)) else {
        session.code = 1
        return
    }
    session.Say(al, text) else {}
    want := Tally(created: plan.clients * plan.requests, refused: 0, failed: 0)
    if !sum.Eq(&want) {
        session.code = 4
    }
    words := ["stats"]
    session.Run(&arena, io, al, words[..]) else e {
        Report(&arena, al, session, words[..], e)
    }
}

/// `Script` or `Load` against a server in this process, then the cancel that
/// stops it: the client task of `--embed`.
export Drive(s: &Scope, heap: &Heap, io: Io, session: mut Session, script: [][]str, plan: ?Plan) {
    defer s.Cancel()
    if p := plan {
        Load(heap, io, session, p)
        return
    }
    Script(heap, io, session, script)
}

// One load client: count posts by outcome into t[0].
Post(heap: &Heap, io: Io, base: str, attempts: int, client: int, requests: int, t: mut []Tally) {
    var arena := Arena.New(heap) else {
        t[0].failed += requests
        return
    }
    defer arena.Free()
    for j in 0..requests {
        var scratch := arena.Sub() else {
            t[0].failed += 1
            continue
        }
        defer scratch.Free()
        title := scratch.Fmt("load {client}-{j}", (client, j)) else {
            t[0].failed += 1
            continue
        }
        tags := ["load"]
        body := NoteJson(&scratch, title, "generated by notes load", tags[..]) else {
            t[0].failed += 1
            continue
        }
        r := Call(&scratch, io, base, "POST", "/notes", body, attempts) else {
            t[0].failed += 1
            continue
        }
        if r.status == 201 {
            t[0].created += 1
        } else {
            t[0].refused += 1
        }
    }
}

// Prints why a command failed and sets the exit code.
Report(a: &Arena, al: &Alloc, session: mut Session, words: []str, e: Usage | Error) {
    cmd := if words.Len() > 0 { words[0] } else { "" }
    code := match e {
        Usage { 2 }
        _ { 1 }
    }
    text := match e {
        Usage(word) {
            if word == 0 {
                a.Fmt("notes: unknown command {cmd}; see notes --help\n", (cmd)) else { "" }
            } else if word < words.Len() {
                a.Fmt("notes: {cmd}: bad argument {w}\n", (cmd, w: words[word])) else { "" }
            } else {
                a.Fmt("notes: {cmd}: missing argument\n", (cmd)) else { "" }
            }
        }
        _ {
            a.Fmt("notes: {cmd}: {e}\n", (cmd, e)) else { "" }
        }
    }
    session.Complain(al, text) else {}
    session.code = code
}
