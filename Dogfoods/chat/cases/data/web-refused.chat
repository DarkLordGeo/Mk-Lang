# The front end refuses event streams it cannot serve: a nick in use (409),
# then a full house (503); a WebSocket line too long for the server is refused.
amy: !ws /rooms/lab/ws?nick=amy
watch: !events /rooms/lab/events?nick=amy
watch: !eof
bea: !ws /rooms/lab/ws?nick=bea
full: !events /rooms/lab/events
full: !eof
amy: MSG #lab 
amy: WHO #lab
